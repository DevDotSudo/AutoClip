# =========================================================
# APP
# =========================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# =========================================================
# SUPABASE
# Keep the service role key server-side only.
# =========================================================
# Original server-side names retained for migration compatibility.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Next.js browser-safe aliases (same values as above).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =========================================================
# CLOUDFLARE R2
# =========================================================
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_TTL_SECONDS=900

# =========================================================
# TRANSCRIPTION
# Provider adapter stays generic so you can swap vendors later.
# =========================================================
TRANSCRIPTION_PROVIDER=gemini
# Gemini processing uses GEMINI_API_KEY below; no separate transcription key is required.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=

# =========================================================
# GEMINI
# =========================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =========================================================
# MEDIA WORKER
# =========================================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
# Optional for sites that require an authenticated browser session (for example, YouTube 403 responses).
# Use a browser name such as chrome, firefox, or edge, or provide a Netscape cookies file instead.
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
YTDLP_FORCE_IPV4=0
AUTOCLIP_TEMP_DIR=
MAX_CONCURRENT_JOBS=1
JOB_POLL_INTERVAL_MS=2000
JOB_MAX_ATTEMPTS=3

# Optional GitHub Actions remote worker dispatch.
# The repository must be public for GitHub-hosted free minutes.
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORY=
GITHUB_ACTIONS_WORKFLOW=autoclip-worker.yml
GITHUB_ACTIONS_REF=main
